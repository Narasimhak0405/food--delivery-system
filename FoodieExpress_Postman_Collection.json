{
  "info": {
    "name": "FoodieExpress Secured REST API Collection",
    "description": "JWT-Secured REST API collection for FoodieExpress with Role-Based Access Control (RBAC)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (Public)",
      "item": [
        {
          "name": "Register User (Generates BCrypt Hash & JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Raina\",\n  \"email\": \"suresh@example.com\",\n  \"password\": \"securePass123!\",\n  \"phone\": \"9876543299\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login as Customer (Rahul)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login as Admin User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@foodieexpress.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Public Catalog (No Auth Required)",
      "item": [
        {
          "name": "Get All Restaurants",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/restaurants", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "restaurants"] }
          }
        },
        {
          "name": "Search Restaurants by Cuisine/Name",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/restaurants/search?query=Biryani", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "restaurants", "search"], "query": [{ "key": "query", "value": "Biryani" }] }
          }
        },
        {
          "name": "Get Restaurant Menu Dishes",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/restaurants/1/menu", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "restaurants", "1", "menu"] }
          }
        }
      ]
    },
    {
      "name": "3. Customer Protected APIs (Requires Bearer Token)",
      "item": [
        {
          "name": "Get User Cart (Auth Required)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/api/cart?userId=2", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "cart"], "query": [{ "key": "userId", "value": "2" }] }
          }
        },
        {
          "name": "Add Item to Cart (Auth Required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodItemId\": 1,\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "http://localhost:8080/api/cart/items?userId=2", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "cart", "items"], "query": [{ "key": "userId", "value": "2" }] }
          }
        },
        {
          "name": "Place Order (Auth Required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"restaurantId\": 1,\n  \"deliveryAddressId\": 1,\n  \"paymentMethod\": \"UPI\",\n  \"specialInstructions\": \"Leave at door\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/orders", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "orders"] }
          }
        },
        {
          "name": "View Order History (Auth Required)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/api/orders/user/2", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "orders", "user", "2"] }
          }
        }
      ]
    },
    {
      "name": "4. Admin & Restaurant Owner Protected APIs",
      "item": [
        {
          "name": "Create Food Item (Requires RESTAURANT_OWNER or ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant\": { \"id\": 1 },\n  \"category\": { \"id\": 1 },\n  \"name\": \"Chef Special Kebab Platter\",\n  \"description\": \"Assortment of grilled kebabs with mint chutney.\",\n  \"price\": 499.00,\n  \"isVeg\": false,\n  \"isAvailable\": true\n}"
            },
            "url": { "raw": "http://localhost:8080/api/food-items", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "food-items"] }
          }
        },
        {
          "name": "Delete Restaurant (Requires ADMIN Role)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/api/restaurants/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "restaurants", "1"] }
          }
        },
        {
          "name": "Get Admin Dashboard Stats (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/api/admin/stats", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "admin", "stats"] }
          }
        },
        {
          "name": "Get Restaurant Kitchen Orders (RESTAURANT_OWNER)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/api/restaurant-portal/orders?restaurantId=1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "restaurant-portal", "orders"], "query": [{ "key": "restaurantId", "value": "1" }] }
          }
        },
        {
          "name": "Update Kitchen Order Status (Accept / Preparing / Delivered)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/api/restaurant-portal/orders/ORD-2026-001/status?status=PREPARING", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "restaurant-portal", "orders", "ORD-2026-001", "status"], "query": [{ "key": "status", "value": "PREPARING" }] }
          }
        },
        {
          "name": "Toggle Dish Availability (In Stock / Out of Stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/api/restaurant-portal/food-items/1/availability?isAvailable=false", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "restaurant-portal", "food-items", "1", "availability"], "query": [{ "key": "isAvailable", "value": "false" }] }
          }
        }
      ]
    }
  ]
}
